# Oura OAuth2（セットアップ: python3 scripts/oura_oauth_setup.py）
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REFRESH_TOKEN=
# 取得済み token とその失効時刻（Unix 秒）。省略時は起動時に refresh します。
OURA_ACCESS_TOKEN=
OURA_ACCESS_TOKEN_EXPIRES_AT=
# GitHub Actions の Secrets 書き込み権限付き fine-grained PAT（任意）
SECRETS_WRITE_TOKEN=

# Discord Webhook URL (定期通知用)
# Create it in: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# Discord Bot Token (会話型Bot用)
# Get it from: https://discord.com/developers/applications
# 1. Create Application > Bot > Reset Token
# 2. Enable "Message Content Intent" in Bot settings
DISCORD_BOT_TOKEN=your_bot_token_here

# Daily steps goal (optional, default: 8000)
DAILY_STEPS_GOAL=8000

# Target wake time for bedtime calculation (optional, default: 07:00)
TARGET_WAKE_TIME=07:00
